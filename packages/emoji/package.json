{
  "name": "@cw/emoji",
  "version": "0.1.0",
  "description": "1 Million Emojis: a shared 1000 × 1000 canvas of emoji cells, a palette of whole emoji with their Unicode names and groups, and Jev joining a drawing by choosing a square and an emoji as one typed Choice.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./canvas": "./src/canvas.ts",
    "./palette-names": "./src/palette-names.ts",
    "./stamps": "./src/stamps.ts",
    "./board": "./src/board.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "format": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "palette-names": "node scripts/palette-names.ts"
  },
  "dependencies": {
    "@cw/jev": "*"
  },
  "devDependencies": {
    "@cw/eslint-config": "*",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "emojilib": "^4.0.3",
    "eslint": "^10.13.0",
    "typescript": "7.1.0-beta",
    "unicode-emoji-json": "^0.9.0",
    "vitest": "^5.0.1"
  }
}
