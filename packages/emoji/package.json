{
  "name": "@cw/emoji",
  "version": "0.1.0",
  "description": "1 Million Emojis: a canvas of a million emoji cells read as one strip, a palette of whole emoji with their Unicode names, and Jev painting a cell as one typed Choice.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./canvas": "./src/canvas.ts",
    "./names": "./src/names.ts",
    "./jev-paint": "./src/jev-paint.ts"
  },
  "files": ["src", "LICENSE", "README.md"],
  "scripts": {
    "lint": "eslint .",
    "format": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cw/jev": "*",
    "unicode-emoji-json": "^0.9.0"
  },
  "devDependencies": {
    "@cw/eslint-config": "*",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
